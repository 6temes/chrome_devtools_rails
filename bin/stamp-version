#!/usr/bin/env ruby

version, path = ARGV
abort "usage: bin/stamp-version VERSION FILE" unless version && path

# `1.2.3-rc1` would build as `1.2.3.pre.rc1` and miss the tag-named gem file.
unless Gem::Version.correct?(version) && Gem::Version.new(version).to_s == version
  abort "#{version.inspect} is not a release version"
end

pattern = /^(\s*VERSION = )"[^"]*"$/
source = File.read(path)
count = source.scan(pattern).size
abort "#{path}: expected one quoted VERSION literal, found #{count}" unless count == 1

File.write path, source.sub(pattern) { "#{$1}\"#{version}\"" }

# The text match cannot see a later reassignment, a block comment or a suffix
# on the literal, so the stamped file is loaded the way a host app would load it.
loaded = IO.popen({ "RUBYOPT" => nil, "BUNDLE_GEMFILE" => nil },
  [ RbConfig.ruby, "--disable-gems", "-e", "load ARGV[0]; print ChromeDevtoolsRails::VERSION", path ],
  err: File::NULL, &:read)

unless $?.success? && loaded == version
  File.write path, source
  abort "#{path}: loads as #{loaded.inspect} after stamping, not #{version.inspect}"
end
